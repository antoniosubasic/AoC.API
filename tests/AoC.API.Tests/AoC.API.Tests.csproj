<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>AoC.API.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The suite runs on the oldest runtime it can find, so the net8.0 build
         is exercised on .NET 8 where that runtime is installed - and still runs
         on a machine that only has the newer one. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AoC.API/AoC.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Saved response bodies, read at run time rather than embedded, so a
         failing parser test can be diffed against the file it was given. -->
    <Content Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
